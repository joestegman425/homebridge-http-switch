{
  "pluginAlias": "HomebridgeHttpSwitch",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Homebridge Http Switch"
      },
      "switches": {
        "type": "array",
        "items": {
          "title": "Switches",
          "type": "object",
          "properties": {
            "displayName": {
              "title": "Name of the switch in the Home app",
              "type": "string",
              "required": true,
              "placeholder": "<enter new name>"
            },
            "autoOn": {
              "title": "When turned off, auto turn back on (stateless switch)",
              "type": "boolean",
              "default": false
            },
            "autoOnDelay": {
              "title": "Time to wait before turning back on (in milliseconds)",
              "type": "integer",
              "default": 500
            },
            "offUrl": {
              "title": "URL for the GET request when the switch is turned off",
              "type": "string",
              "required": true
            },
            "onUrl": {
              "title": "URL for the GET request when the switch is turned on",
              "description": "Not required",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
